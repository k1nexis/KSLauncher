<Window x:Class="KSLauncher.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка KS Launcher" Height="580" Width="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="#0A0E0D" Foreground="#F4F7F5" FontFamily="Segoe UI" FontSize="14"
        ResizeMode="NoResize">
  <Window.Resources>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#9333EA" Offset="0.0"/>
      <GradientStop Color="#06B6D4" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfacePanel" Color="#121917"/>
    <SolidColorBrush x:Key="SurfaceBorder" Color="#25372C"/>
    <SolidColorBrush x:Key="MutedText" Color="#8FA297"/>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#090D0C"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#06B6D4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E2ECE6"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#18221F"/>
      <Setter Property="Foreground" Value="#F4F7F5"/>
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#25352C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1.5" CornerRadius="16" Background="#0C1210">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Шапка с перетаскиванием и кнопкой закрытия -->
      <DockPanel Grid.Row="0" Margin="22,18,22,10" LastChildFill="False" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="KS" Foreground="#0E1311" FontSize="15" FontWeight="Black" HorizontalAlignment="Center"/>
              <TextBlock Text="LAUNCHER" Foreground="#0E1311" FontSize="5.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="KS LAUNCHER INSTALLER" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Мастер установки лаунчера и игровых файлов" FontSize="11" Foreground="{StaticResource MutedText}"/>
          </StackPanel>
        </StackPanel>

        <Button Content="✕" Width="30" Height="30" Padding="0" FontSize="13" Foreground="#8FA297" Background="Transparent" 
                BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Close_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </DockPanel>

      <!-- Основное содержимое установки -->
      <Grid x:Name="SetupContentGrid" Grid.Row="1" Margin="24,10,24,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <!-- 1. Папка установки лаунчера -->
          <Border Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Папка установки KS Launcher" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
              <TextBlock Text="Куда будет установлен исполняемый файл лаунчера." FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,3,0,8"/>
              <DockPanel LastChildFill="True">
                <Button Content="Обзор..." Style="{StaticResource SecondaryBtn}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseInstallFolder_Click"/>
                <TextBox x:Name="InstallFolderBox"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- 2. Папка для файлов Minecraft и сборок -->
          <Border Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <TextBlock Text="Папка файлов Minecraft и сборок" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text="Любой диск (D:, E:, F:...)" FontSize="11" FontWeight="Bold" Foreground="#06B6D4" DockPanel.Dock="Right" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="Сюда скачиваются все версии игры, моды, библиотеки и миры (гигабайты данных). Позволяет сберечь место на системном диске C:." 
                         FontSize="12" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,8"/>
              <DockPanel LastChildFill="True">
                <Button Content="Обзор..." Style="{StaticResource SecondaryBtn}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseGameFolder_Click"/>
                <TextBox x:Name="GameFolderBox"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- 3. Опции ярлыков -->
          <Border Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="14,14,14,4" Margin="0,0,0,14">
            <StackPanel>
              <CheckBox x:Name="DesktopShortcutCheck" Content="Создать ярлык на рабочем столе" IsChecked="True"/>
              <CheckBox x:Name="StartMenuShortcutCheck" Content="Создать ярлык в меню Пуск" IsChecked="True"/>
              <CheckBox x:Name="LaunchAfterInstallCheck" Content="Запустить KS Launcher сразу после завершения" IsChecked="True"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Нижняя панель действий -->
        <StackPanel Grid.Row="1">
          <!-- Индикатор прогресса -->
          <ProgressBar x:Name="InstallProgress" Height="6" Margin="0,0,0,8" Visibility="Collapsed" Background="#18221F" Foreground="{StaticResource AccentGradient}"/>
          <TextBlock x:Name="StatusLabel" Text="" FontSize="12" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed"/>

          <Button x:Name="InstallButton" Content="УСТАНОВИТЬ KS LAUNCHER" Height="48" FontSize="15" FontWeight="Bold" 
                  Foreground="#0E1311" Cursor="Hand" Click="Install_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{StaticResource AccentGradient}" CornerRadius="10">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Экран успешного завершения -->
      <Grid x:Name="SuccessGrid" Grid.Row="1" Margin="24" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
          <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="✓" FontSize="34" FontWeight="Bold" Foreground="#0E1311" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
          </Border>

          <TextBlock Text="KS Launcher успешно установлен!" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock Text="Все параметры, ярлыки и папки для игры успешно настроены." FontSize="14" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

          <Border Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,24">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Папка лаунчера:" Foreground="{StaticResource MutedText}" FontSize="12" Width="130"/>
                <TextBlock x:Name="SuccessInstallPathText" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </DockPanel>
              <DockPanel>
                <TextBlock Text="Папка Minecraft:" Foreground="{StaticResource MutedText}" FontSize="12" Width="130"/>
                <TextBlock x:Name="SuccessGamePathText" Foreground="#06B6D4" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <Button x:Name="LaunchAppButton" Content="Запустить KS Launcher" Height="46" FontSize="14" FontWeight="Bold" 
                  Foreground="#0E1311" Cursor="Hand" Click="LaunchApp_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{StaticResource AccentGradient}" CornerRadius="10">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
