# Токен вашего бота из https://discord.com/developers/applications
DISCORD_TOKEN=ВАШ_ТОКЕН_БОТА

# ID канала или форума #помощь-и-баги (необязательно; если пусто — отвечает при @упоминании и в каналах со словом "помощ" / "баг" / "support")
SUPPORT_CHANNEL_ID=

# 1) Локальная нейросеть без лимитов (Ollama: https://ollama.com, модель например qwen2.5:7b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 2) Бесплатный облачный API Groq (https://console.groq.com/keys) — очень быстрый и щедрый бесплатный лимит
GROQ_API_KEY=

# 3) Бесплатный облачный API Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 4) Бесплатные модели OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
