<Window x:Class="KSLauncher.App.JoinFriendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Зайти к другу" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
  <Border x:Name="DialogBorder" Background="#121917" BorderBrush="#293630" BorderThickness="1" CornerRadius="18" Padding="24">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.65"/>
    </Border.Effect>
    <StackPanel>
      <DockPanel LastChildFill="False" Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="IconBadge" Width="38" Height="38" CornerRadius="11" Background="#1B2A23" Margin="0,0,12,0">
            <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock x:Name="TitleText" Text="Друг играет с модами" FontSize="17" FontWeight="Bold" Foreground="#F4F7F5"/>
            <TextBlock x:Name="SubtitleText" Text="Выберите режим подключения к серверу" FontSize="12" Foreground="#91A19A"/>
          </StackPanel>
        </StackPanel>
        <Button Content="×" DockPanel.Dock="Right" Width="32" Height="32" Padding="0" FontSize="16"
                Background="Transparent" BorderThickness="0" Foreground="#91A19A" Cursor="Hand" Click="Cancel_Click"/>
      </DockPanel>

      <Border x:Name="InfoCard" Background="#0E1412" BorderBrush="#26372D" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock x:Name="ServerInfoText" FontSize="13" FontWeight="SemiBold" Foreground="#F4F7F5" TextWrapping="Wrap"/>
          <TextBlock x:Name="ModsListText" FontSize="12" Foreground="#91A19A" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <StackPanel x:Name="OwnInstancePanel" Margin="0,0,0,16">
        <TextBlock Text="Своя сборка (если выберете «Поставить свои моды»):" FontSize="12" Foreground="#91A19A" Margin="0,0,0,6"/>
        <ComboBox x:Name="OwnInstancesBox" DisplayMemberPath="Name"/>
      </StackPanel>

      <StackPanel>
        <Button x:Name="WithFriendModsBtn" Content="⬇   Зайти с модами друга (установить и подключиться)"
                Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderBrush="{DynamicResource Accent}"
                FontWeight="Bold" Padding="14,12" Margin="0,0,0,8" Cursor="Hand" Click="WithFriendMods_Click"/>
        <Button x:Name="WithOwnModsBtn" Content="⚙   Поставить свои моды (выбранная сборка)"
                Background="#18221F" Foreground="#F4F7F5" BorderBrush="#293630"
                FontWeight="SemiBold" Padding="14,11" Margin="0,0,0,8" Cursor="Hand" Click="WithOwnMods_Click"/>
        <Button x:Name="WithoutModsBtn" Content="▶   Зайти без модов (чистый Vanilla)"
                Background="#141C19" Foreground="#91A19A" BorderBrush="#24312B"
                FontWeight="SemiBold" Padding="14,10" Margin="0,0,0,10" Cursor="Hand" Click="WithoutMods_Click"/>
        <Button Content="Отмена" Background="Transparent" Foreground="#91A19A" BorderThickness="0"
                Padding="10,6" HorizontalAlignment="Right" Cursor="Hand" Click="Cancel_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
