<Window x:Class="KSLauncher.App.RepairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Починка сборки — KS Launcher" Width="640" Height="530"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False"
        Background="#0B0F0E" Foreground="#F4F7F5" FontFamily="Segoe UI" FontSize="14"
        ShowInTaskbar="False" ResizeMode="NoResize">
  <Border x:Name="DialogBorder" Background="#111614" BorderBrush="#25352C" BorderThickness="1.5" CornerRadius="16" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Шапка окна -->
      <DockPanel Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border Width="40" Height="40" CornerRadius="10" Background="#2A1719" BorderBrush="#E11D48" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
          <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Button Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Foreground="#8FA39A" Background="Transparent" 
                BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Close_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#293932"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Обнаружен сбой при запуске модов" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
          <TextBlock x:Name="InstanceInfoText" Text="Сборка: Minecraft" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Блок объяснения проблемы -->
      <Border Grid.Row="1" Background="#17221D" BorderBrush="#26382E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="🔍 ЧТО ПРОИЗОШЛО:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
          <TextBlock x:Name="ExplanationText" Text="Игра завершилась с ошибкой. В сборке обнаружены несовместимые моды или отсутствующие обязательные библиотеки." 
                     FontSize="13.5" Foreground="#E2ECE6" TextWrapping="Wrap" LineHeight="20"/>
        </StackPanel>
      </Border>

      <!-- Лог ошибки / Crash Report -->
      <Grid Grid.Row="2" Margin="0,0,0,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
          <TextBlock Text="📋 ЛОГ ОШИБКИ И СБОЯ:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
          <Button Content="📋 Скопировать лог" Padding="8,3" FontSize="11" Background="#1C2721" Foreground="#CAD7D1" BorderBrush="#35473D" BorderThickness="1" DockPanel.Dock="Right" Cursor="Hand" Click="CopyLog_Click"/>
        </DockPanel>
        <TextBox x:Name="LogTextBox" Grid.Row="1" Background="#0A0E0D" Foreground="#A7F3D0" BorderBrush="#25352C" 
                 BorderThickness="1" FontFamily="Consolas, monospace" FontSize="11.5" Padding="10" 
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </Grid>

      <!-- Описание действий починки -->
      <Border Grid.Row="3" Background="#121D18" BorderBrush="#25352C" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
        <TextBlock Text="✨ Починка проверит целостность библиотек, исключит повреждённые моды, докачает обязательные зависимости и восстановит работоспособность сборки." 
                   FontSize="12" Foreground="#86EFAC" TextWrapping="Wrap" LineHeight="17"/>
      </Border>

      <!-- Кнопки управления -->
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- Серая обычная кнопка "Закрыть" -->
        <Button x:Name="CloseButton" Content="Закрыть" Padding="22,10" Margin="0,0,12,0" FontSize="13.5" FontWeight="SemiBold"
                Background="#1B2521" Foreground="#94A3B8" BorderBrush="#2A3932" BorderThickness="1" Cursor="Hand" Click="Close_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#24332B"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <!-- Яркая неоновая кнопка "Починить сборку" -->
        <Button x:Name="RepairButton" Content="🔧   Починить сборку" Padding="26,10" FontSize="14" FontWeight="Bold"
                Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="Repair_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <Border.Effect>
                  <DropShadowEffect Color="#06B6D4" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Button.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#9333EA" Offset="0.0"/>
              <GradientStop Color="#06B6D4" Offset="1.0"/>
            </LinearGradientBrush>
          </Button.Background>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
