<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\kslauncher.ico</ApplicationIcon>
    <Authors>KS Launcher Team</Authors>
    <Company>KS Launcher Team</Company>
    <Product>KS Launcher</Product>
    <Description>Официальный клиент KS Launcher Minecraft Desktop</Description>
    <Copyright>Copyright © 2026 KS Launcher Team</Copyright>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\kslauncher.ico" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.4.0" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" Aliases="CmlForge" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
  </ItemGroup>

</Project>
