<Window x:Class="KSLauncher.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Консоль логов Minecraft — KS Launcher" Height="500" Width="800" MinHeight="350" MinWidth="500"
        WindowStartupLocation="CenterOwner" Background="#0C1210" Foreground="#F4F7F5"
        FontFamily="Consolas" WindowStyle="ToolWindow">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
      <TextBlock Text="Консоль вывода Minecraft (stdout / stderr)" FontSize="14" FontWeight="Bold" Foreground="#A6F36B" VerticalAlignment="Center"/>
      <Button Content="📋  Скопировать всё" Padding="12,6" Margin="10,0,0,0" DockPanel.Dock="Right" Click="CopyLogs_Click"/>
      <Button Content="🧹  Очистить" Padding="12,6" DockPanel.Dock="Right" Click="ClearLogs_Click"/>
    </DockPanel>

    <TextBox x:Name="LogTextBox" Grid.Row="1" Background="#080C0B" Foreground="#D5E8DF" BorderBrush="#26372D" BorderThickness="1"
             Padding="10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="12"/>

    <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
      <CheckBox x:Name="AutoScrollBox" Content="Автоматическая прокрутка вниз" Foreground="#91A19A" IsChecked="True" VerticalAlignment="Center"/>
      <TextBlock x:Name="LineCountLabel" Text="Строк: 0" Foreground="#91A19A" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
