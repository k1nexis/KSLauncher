<Window x:Class="KSLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KS Launcher" Height="820" Width="1360" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#0B0F0E" Foreground="#F4F7F5"
        FontFamily="Segoe UI" WindowStyle="None" AllowsTransparency="False">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBase" Color="#0B0F0E"/><SolidColorBrush x:Key="Panel" Color="#D9121917"/><SolidColorBrush x:Key="Panel2" Color="#D918221F"/><SolidColorBrush x:Key="SidebarSurface" Color="#EE101614"/><SolidColorBrush x:Key="HeroSurface" Color="#14221C"/><SolidColorBrush x:Key="SurfaceBorder" Color="#26372D"/>
    <SolidColorBrush x:Key="Accent" Color="#A6F36B"/><SolidColorBrush x:Key="Muted" Color="#91A19A"/>
        <Style x:Key="CaptionButton" TargetType="Button"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#24332B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#18221F"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#24332B"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#50634F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#0E1412"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/></Style>
    <Style x:Key="ComboToggleButtonStyle" TargetType="ToggleButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#18221F"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="Padding" Value="7"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#18221F"/><Setter Property="Padding" Value="9,7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#293A30"/></Trigger></Style.Triggers></Style></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Style="{StaticResource ComboToggleButtonStyle}" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7"><DockPanel LastChildFill="True"><Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#91A19A" Width="8" Height="4" Stretch="Fill" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/></DockPanel></Border></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#18221F" BorderBrush="#293630" BorderThickness="1" CornerRadius="8" MaxHeight="340"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Background" Value="#111714"/><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="28" MinWidth="28" Background="#293630"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#35463D" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>    <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#0E1412"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="Padding" Value="11,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" TextElement.Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem"><Setter Property="Height" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#91A19A"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="HeaderText" ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1C2923"/><Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="14" Height="14" CornerRadius="4" Background="#0E1412" BorderBrush="#46564E" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 1 5 L 4 8 L 10 1" Stroke="#11160F" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#17211C"/><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#34483B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#18251E"/><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="ProgressBar"><Setter Property="Background" Value="#222C27"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="#293630"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24" VerticalAlignment="Center"><Track x:Name="PART_Track" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False" Height="4" Background="{TemplateBinding Foreground}" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False" Height="4" Background="{TemplateBinding Background}" BorderThickness="0"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="16" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Accent}" Stroke="#101512" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="ShellRoot" Background="{DynamicResource SurfaceBase}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="BackgroundLayer" Grid.ColumnSpan="2" Panel.ZIndex="0" IsHitTestVisible="False" Opacity="1"><Grid><Image x:Name="ImageBackground" Stretch="UniformToFill" Visibility="Collapsed"/><MediaElement x:Name="VideoBackground" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" IsMuted="True" Visibility="Collapsed" MediaEnded="VideoBackground_MediaEnded"/><Border x:Name="BackgroundScrim" Background="#0B0F0E" Opacity="0.70"/></Grid></Border>
    <Border Grid.Column="0" Panel.ZIndex="1" Background="{DynamicResource SidebarSurface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,1,0"><DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,7,0,32"><Border x:Name="LauncherLogo" Width="54" Height="48" CornerRadius="11" Background="{DynamicResource Accent}"><StackPanel VerticalAlignment="Center"><TextBlock Text="KS" Foreground="#101512" FontSize="18" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock Text="LAUNCHER" Foreground="#101512" FontSize="6" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0"/></StackPanel></Border><StackPanel Margin="11,1,0,0"><TextBlock Text="KS LAUNCHER" FontSize="15" FontWeight="Bold"/><TextBlock Text="MINECRAFT • DESKTOP" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel><TextBlock Text="РАЗДЕЛЫ" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,11"/><Button x:Name="NavHomeButton" Content="⌂    Главная" HorizontalContentAlignment="Left" Background="#1C2923" BorderBrush="#1C2923" Margin="0,0,0,6" Click="GoHome_Click"/><Button x:Name="NavLibraryButton" Content="▦    Библиотека" HorizontalContentAlignment="Left" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Library_Click"/><Button x:Name="NavModsButton" Content="⌘    Моды и ресурсы" HorizontalContentAlignment="Left" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Mods_Click"/><Button x:Name="NavAccountsButton" Content="◉    Аккаунты" HorizontalContentAlignment="Left" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Accounts_Click"/><Button x:Name="NavSettingsButton" Content="⚙    Настройки" HorizontalContentAlignment="Left" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Settings_Click"/></StackPanel><Border DockPanel.Dock="Bottom" Background="#18211E" CornerRadius="12" Padding="14" Margin="0,0,0,4"><StackPanel><TextBlock Text="АКТИВНЫЙ ПРОФИЛЬ" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SidebarProfile" Text="Игрок • Offline" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Локальная сессия" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Border></DockPanel></Border>
    <Grid Grid.Column="1" Panel.ZIndex="1" Margin="30,22,30,24"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="False"><TextBlock x:Name="PageTitle" Text="Обзор" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MouseLeftButtonDown="Window_DragMove"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="–" Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="Minimize_Click"/><Button Content="□" Style="{StaticResource CaptionButton}" ToolTip="Развернуть или восстановить" Click="Maximize_Click"/><Button Content="×" Style="{StaticResource CloseCaptionButton}" ToolTip="Закрыть" Click="Close_Click"/></StackPanel></DockPanel>
      <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,18,0,12" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
        <TabItem Header="Главная"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,10,12"><Border Height="260" CornerRadius="20" Background="{DynamicResource HeroSurface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" Padding="30"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="ВАШ МИР. ВАШИ ПРАВИЛА." FontSize="13" Foreground="{DynamicResource Accent}"/><TextBlock Text="Готов к запуску" FontSize="36" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Выберите версию игры и профиль запуска" Foreground="{StaticResource Muted}" FontSize="13"/><StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button x:Name="PlayButton" Content="▶   Установить и играть" Background="{DynamicResource Accent}" Foreground="#11160F" BorderBrush="{DynamicResource Accent}" Padding="20,13" Click="Play_Click"/><ComboBox x:Name="VersionBox" Width="160" Margin="12,0,0,0" DisplayMemberPath="Id" SelectedIndex="0" SelectionChanged="GameProfile_Changed"/><ComboBox x:Name="GameLoaderBox" Width="125" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="GameLoaderBox_SelectionChanged"><ComboBoxItem Content="Vanilla" Tag="vanilla"/><ComboBoxItem Content="Fabric" Tag="fabric"/><ComboBoxItem Content="Forge" Tag="forge"/><ComboBoxItem Content="NeoForge" Tag="neoforge"/><ComboBoxItem Content="Quilt" Tag="quilt"/></ComboBox></StackPanel></StackPanel><Border Grid.Column="1" CornerRadius="18" Background="{DynamicResource Panel2}" Margin="35,8,0,8"><Grid><Ellipse Width="180" Height="180" Fill="{DynamicResource Accent}" Opacity="0.08"/><TextBlock Text="KS" FontSize="88" FontWeight="Black" Foreground="{DynamicResource Accent}" Opacity="0.82" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid></Border>
          <TextBlock Text="БЫСТРЫЕ НАСТРОЙКИ" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,24,0,12"/><UniformGrid Columns="3"><Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="ВЕРСИЯ" FontSize="13" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ProfileSummaryText" Text="Vanilla · Release" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Каталог релизов Mojang" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel></Border><Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="ПАМЯТЬ JVM" FontSize="13" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RamLabel" Text="4 ГБ" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2"/><Slider x:Name="RamSlider" Minimum="2" Maximum="12" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RamSlider_Changed"/><TextBlock x:Name="RamWarningText" Text="Оставьте запас памяти для Windows" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel></Border><Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="СИСТЕМА" FontSize="13" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HardwareLabel" Text="Определение…" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="JVM сама распределяет CPU-потоки" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel></Border></UniformGrid>
          <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,14,0,0"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="СОСТОЯНИЕ ЗАПУСКА" FontSize="13" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ProgressText" Text="ГОТОВ" Foreground="{DynamicResource Accent}" FontSize="13" DockPanel.Dock="Right"/></DockPanel><ProgressBar x:Name="InstallProgress" Height="5" Margin="0,13,0,10" Minimum="0" Maximum="100"/><TextBlock x:Name="StatusText" Text="Загружаю полный список официальных версий Minecraft…" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Библиотека"><StackPanel Margin="12"><TextBlock Text="Библиотека" FontSize="24" FontWeight="Bold"/><TextBlock Text="Управление установленными версиями и файлами профиля." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/><Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Каталог версий Minecraft" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Выберите релиз на главной странице. Список загружается из официального manifest Mojang и включает все опубликованные релизы." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="Перейти к запуску" HorizontalAlignment="Left" Click="GoHome_Click"/></StackPanel></Border></StackPanel></TabItem>
        <TabItem Header="Моды"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Каталог модов и ресурсов" FontSize="24" FontWeight="Bold"/><TextBlock Text="Ищите и устанавливайте проекты прямо в папку KS Launcher. Modrinth проверяет версии игры и зависимости." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18"/></StackPanel><DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="ModSearchBox" Text="sodium" MinWidth="220"/><Button Content="Искать" Margin="8,0,0,0" Click="SearchMods_Click"/><ComboBox x:Name="ProjectTypeBox" Width="145" Margin="8,0,0,0" SelectedIndex="0"><ComboBoxItem Content="Моды" Tag="mod"/><ComboBoxItem Content="Модпаки" Tag="modpack"/><ComboBoxItem Content="Ресурспаки" Tag="resourcepack"/><ComboBoxItem Content="Шейдеры" Tag="shader"/></ComboBox><ComboBox x:Name="ModLoaderBox" Width="125" Margin="8,0,0,0" SelectedIndex="1" SelectionChanged="ModLoaderBox_SelectionChanged"><ComboBoxItem Content="Vanilla" Tag="vanilla"/><ComboBoxItem Content="Fabric" Tag="fabric"/><ComboBoxItem Content="Forge" Tag="forge"/><ComboBoxItem Content="NeoForge" Tag="neoforge"/><ComboBoxItem Content="Quilt" Tag="quilt"/><ComboBoxItem Content="Any" Tag="Any"/></ComboBox><ComboBox x:Name="ModVersionBox" Width="130" Margin="8,0,0,0" DisplayMemberPath="Id"/></DockPanel><ListBox x:Name="ModsList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#F4F7F5" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="#121917" CornerRadius="12" Padding="15" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#91A19A" TextWrapping="Wrap" Margin="0,4,12,0"/><TextBlock Text="{Binding Downloads, StringFormat={}{0:N0} загрузок}" Foreground="#A6F36B" FontSize="13" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Открыть страницу" Padding="10,8" VerticalAlignment="Center" Margin="0,0,8,0" Click="OpenMod_Click"/><Button Grid.Column="2" Content="Скачать в лаунчер" Padding="12,8" VerticalAlignment="Center" Click="InstallMod_Click"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
        <TabItem Header="Аккаунты"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Аккаунты" FontSize="24" FontWeight="Bold"/><TextBlock Text="KS System управляет учётной записью лаунчера; для игры используйте официальную Microsoft-лицензию или офлайн-профиль." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/><Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="Офлайн-профиль" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Локальный ник. Не даёт доступ к серверам online-mode." Foreground="{StaticResource Muted}" Margin="0,5,0,12"/><DockPanel><TextBox x:Name="OfflineNameBox" Text="Steve" Width="240"/><Button Content="Сохранить ник" Margin="9,0,0,0" Click="SaveOffline_Click"/></DockPanel></StackPanel></Border><Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="Microsoft · Minecraft Java" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Официальный вход Microsoft → Xbox → Minecraft. Сессия игры хранится в памяти лаунчера." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/><Button x:Name="MicrosoftLoginButton" Content="Войти через Microsoft" HorizontalAlignment="Left" Click="MicrosoftLogin_Click"/></StackPanel></Border><Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="KS System · аккаунт лаунчера" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Регистрация и косметика KS System. Этот аккаунт не заменяет лицензию Microsoft. URL сайта/API задаётся после публикации на Cloudflare." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBox x:Name="CloudUrlBox" Text="https://kslauncher-api.nerck522.workers.dev" Margin="0,0,0,8"/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel>