<Window x:Class="KSLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KSLauncher.App"
        Title="KS Launcher" Height="860" Width="1400" MinHeight="720" MinWidth="1140"
        Icon="pack://application:,,,/Assets/kslauncher.ico"
        WindowStartupLocation="CenterScreen" Background="#0B0F0E" Foreground="#F4F7F5"
        FontFamily="Segoe UI" FontSize="15" WindowStyle="None" AllowsTransparency="False">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBase" Color="#0B0F0E"/>
    <SolidColorBrush x:Key="Panel" Color="#D9121917"/>
    <SolidColorBrush x:Key="Panel2" Color="#D918221F"/>
    <SolidColorBrush x:Key="SidebarSurface" Color="#EE101614"/>
    <SolidColorBrush x:Key="HeroSurface" Color="#14221C"/>
    <SolidColorBrush x:Key="SurfaceBorder" Color="#26372D"/>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#9333EA" Offset="0.0"/>
      <GradientStop Color="#06B6D4" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Muted" Color="#91A19A"/>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#24332B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TagButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="#17261F"/><Setter Property="BorderBrush" Value="#293F33"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,2"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="TagBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TagBd" Property="Background" Value="#243F30"/><Setter TargetName="TagBd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="TagBd" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#18221F"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#24332B"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#50634F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#0E1412"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundedSearchBoxStyle" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#0E1412"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="15"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="SearchBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="21">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True"><Setter TargetName="SearchBd" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="SearchBd" Property="Background" Value="#121B17"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SearchBd" Property="BorderBrush" Value="#465E50"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ComboToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#18221F"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="Padding" Value="7"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#18221F"/><Setter Property="Padding" Value="9,7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#293A30"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Style="{StaticResource ComboToggleButtonStyle}" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7"><DockPanel LastChildFill="True"><Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#91A19A" Width="8" Height="4" Stretch="Fill" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/></DockPanel></Border></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#18221F" BorderBrush="#293630" BorderThickness="1" CornerRadius="8" MaxHeight="340"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#111714"/><Setter Property="Width" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="28" MinWidth="28" Background="#293630"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#35463D" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="#0E1412"/><Setter Property="BorderBrush" Value="#293630"/><Setter Property="Padding" Value="11,9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" TextElement.Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Height" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#91A19A"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="HeaderText" ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1C2923"/><Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="14" Height="14" CornerRadius="4" Background="#0E1412" BorderBrush="#46564E" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 1 5 L 4 8 L 10 1" Stroke="#11160F" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#F4F7F5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#17211C"/><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#34483B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#18251E"/><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="#222C27"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="#293630"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24" VerticalAlignment="Center"><Track x:Name="PART_Track" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False" Height="4" Background="{TemplateBinding Foreground}" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False" Height="4" Background="{TemplateBinding Background}" BorderThickness="0"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="16" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Accent}" Stroke="#101512" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="ShellRoot" Background="{DynamicResource SurfaceBase}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- Фоновый слой: изображение и видео параллельно -->
    <Border x:Name="BackgroundLayer" Grid.ColumnSpan="2" Panel.ZIndex="0" IsHitTestVisible="False" Opacity="1">
      <Grid>
        <Image x:Name="ImageBackground" Stretch="UniformToFill" Visibility="Visible"/>
        <MediaElement x:Name="VideoBackground" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" IsMuted="True" Visibility="Collapsed" MediaEnded="VideoBackground_MediaEnded"/>
        <Border x:Name="BackgroundScrim" Background="#0B0F0E" Opacity="0.70"/>
        <!-- Анимированный слой частиц (неоновый дождь, снег, искры) -->
        <local:FxVisualHost x:Name="FxHost" IsHitTestVisible="False"/>
      </Grid>
    </Border>

    <!-- Сайдбар -->
    <Border Grid.Column="0" Panel.ZIndex="1" Background="{DynamicResource SidebarSurface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,1,0">
      <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,7,0,32">
            <Border x:Name="LauncherLogo" Width="52" Height="50" CornerRadius="13" Background="{DynamicResource Accent}">
              <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="KS" Foreground="#000000" Opacity="0.35" FontSize="24" FontWeight="Black" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="KS" Foreground="#FFFFFF" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"/>
              </Grid>
            </Border>
            <StackPanel Margin="11,1,0,0">
              <TextBlock Text="KS LAUNCHER" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="MINECRAFT • DESKTOP" FontSize="11" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="РАЗДЕЛЫ" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0,0,11"/>
          <Button x:Name="NavHomeButton" Content="⌂    Главная" HorizontalContentAlignment="Left" FontSize="14" Background="#1C2923" BorderBrush="#1C2923" Margin="0,0,0,6" Click="GoHome_Click"/>
          <Button x:Name="NavLibraryButton" Content="▦    Библиотека" HorizontalContentAlignment="Left" FontSize="14" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Library_Click"/>
          <Button x:Name="NavModsButton" Content="⌘    Моды и ресурсы" HorizontalContentAlignment="Left" FontSize="14" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Mods_Click"/>
          <Button x:Name="NavAccountsButton" Content="◉    Аккаунты" HorizontalContentAlignment="Left" FontSize="14" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Accounts_Click"/>
          <Button x:Name="NavSettingsButton" Content="⚙    Настройки" HorizontalContentAlignment="Left" FontSize="14" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Settings_Click"/>
          <Button x:Name="NavFriendsButton" Content="👥    Друзья" HorizontalContentAlignment="Left" FontSize="14" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Friends_Click"/>
          <Button x:Name="NavServersButton" Content="🖥    Серверы" HorizontalContentAlignment="Left" FontSize="14" BorderBrush="Transparent" Background="Transparent" Margin="0,0,0,6" Click="Servers_Click"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="#18211E" BorderBrush="#25352C" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,4">
          <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
              <TextBlock Text="АКТИВНЫЙ ПРОФИЛЬ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
              <Button Content="⚙ Настроить" Padding="6,2" FontSize="10" FontWeight="SemiBold" Background="#24332B" Foreground="{DynamicResource Accent}" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right" Click="SidebarProfile_Click" ToolTip="Управление аккаунтами и вход"/>
            </DockPanel>

            <!-- Быстрый выбор любого аккаунта прямо из боковой панели -->
            <ComboBox x:Name="SidebarAccountBox" Margin="0,2,0,5" DisplayMemberPath="DisplayName"
                      ToolTip="Выберите активный профиль для игры"
                      SelectionChanged="SidebarAccountBox_SelectionChanged"/>

            <TextBlock x:Name="SidebarProfile" Visibility="Collapsed"/>
            <TextBlock x:Name="SidebarProfileSubtext" Text="Локальная сессия" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- Основная рабочая область -->
    <Grid Grid.Column="1" Panel.ZIndex="1" Margin="30,22,30,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="38"/>
      </Grid.RowDefinitions>

      <!-- Верхний заголовок и кнопки управления окном -->
      <DockPanel Grid.Row="0" LastChildFill="False">
        <TextBlock x:Name="PageTitle" Text="Обзор" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MouseLeftButtonDown="Window_DragMove"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="–" Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="Minimize_Click"/>
          <Button Content="□" Style="{StaticResource CaptionButton}" ToolTip="Развернуть или восстановить" Click="Maximize_Click"/>
          <Button Content="×" Style="{StaticResource CloseCaptionButton}" ToolTip="Закрыть" Click="Close_Click"/>
        </StackPanel>
      </DockPanel>

      <!-- Вкладки контента -->
      <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,18,0,12" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
        
        <!-- 1. Главная вкладка -->
        <TabItem Header="Главная">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,10,12">
              
              <!-- 1. Панель быстрого запуска («Установить и играть» в 1 клик) — НАВЕРХУ -->
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="18" Padding="20,16" Margin="0,0,0,0">
                <DockPanel LastChildFill="False">
                  <!-- Кнопка запуска -->
                  <Button x:Name="PlayButton" Content="▶   УСТАНОВИТЬ И ИГРАТЬ" Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderBrush="{DynamicResource Accent}" Padding="26,14" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="Play_Click"/>
                  <!-- Кнопка остановки сборки -->
                  <Button x:Name="StopGameButton" Content="⏹   ОСТАНОВИТЬ СБОРКУ" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#EF4444" BorderThickness="1" Padding="22,14" FontSize="15" FontWeight="Bold" Cursor="Hand" Visibility="Collapsed" Click="StopGame_Click" ToolTip="Принудительно закрыть зависшее окно игры или фоновый процесс Minecraft"/>

                  <!-- Селекторы версии и загрузчика -->
                  <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="ВЕРСИЯ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                      <ComboBox x:Name="VersionBox" Width="135" DisplayMemberPath="Id" SelectedIndex="0" SelectionChanged="GameProfile_Changed"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,14,0">
                      <TextBlock Text="ЯДРО" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                      <ComboBox x:Name="GameLoaderBox" Width="115" SelectedIndex="0" SelectionChanged="GameLoaderBox_SelectionChanged">
                        <ComboBoxItem Content="Vanilla" Tag="vanilla"/>
                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                        <ComboBoxItem Content="Forge" Tag="forge"/>
                        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                        <ComboBoxItem Content="Quilt" Tag="quilt"/>
                      </ComboBox>
                    </StackPanel>
                  </StackPanel>

                  <!-- Кнопка перехода в библиотеку для детальной настройки -->
                  <Button Content="📚  Все сборки и моды в Библиотеке ➔" Background="#18251F" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" Padding="16,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand" DockPanel.Dock="Right" VerticalAlignment="Center" Click="GoToLibrary_Click" ToolTip="Открыть библиотеку для настройки модов, ядер и создания новых сборок"/>
                </DockPanel>
              </Border>

              <!-- 2. Быстрые настройки -->
              <TextBlock Text="БЫСТРЫЕ НАСТРОЙКИ" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,20,0,10"/>
              <UniformGrid Columns="3">
                <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                  <StackPanel>
                    <TextBlock Text="ВЕРСИЯ" FontSize="13" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="ProfileSummaryText" Text="Vanilla · Release" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBlock Text="Каталог релизов Mojang" Foreground="{StaticResource Muted}" FontSize="13"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                  <StackPanel>
                    <TextBlock Text="ПАМЯТЬ JVM" FontSize="13" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="RamLabel" Text="4 ГБ" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <Slider x:Name="RamSlider" Minimum="2" Maximum="12" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RamSlider_Changed"/>
                    <TextBlock x:Name="RamWarningText" Text="Оставьте запас памяти для Windows" Foreground="{StaticResource Muted}" FontSize="13"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18">
                  <StackPanel>
                    <TextBlock Text="СИСТЕМА" FontSize="13" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="HardwareLabel" Text="Определение…" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBlock Text="JVM сама распределяет CPU-потоки" Foreground="{StaticResource Muted}" FontSize="13"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- 3. Состояние запуска, быстрая починка и кнопка логов -->
              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <DockPanel LastChildFill="False">
                    <TextBlock Text="СОСТОЯНИЕ ЗАПУСКА" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button x:Name="ViewLogsButton" Content="📋   Консоль логов" Background="#1A2821" BorderBrush="#354D3F" Foreground="#FFFFFF" Padding="12,6" Margin="10,0,0,0" DockPanel.Dock="Right" Click="ViewLogs_Click"/>
                    <Button x:Name="QuickRepairButton" Content="🔧   Починить сборку" Background="#26362D" BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource Accent}" Padding="12,6" Margin="10,0,0,0" DockPanel.Dock="Right" Visibility="Collapsed" Click="QuickRepair_Click"/>
                    <TextBlock x:Name="ProgressText" Text="ГОТОВ" Foreground="{DynamicResource Accent}" FontSize="13" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ProgressBar x:Name="InstallProgress" Height="5" Margin="0,13,0,10" Minimum="0" Maximum="100"/>
                  <TextBlock x:Name="StatusText" Text="Загружаю полный список официальных версий Minecraft…" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- 4. Мониторинг серверов (Пока что никто не играет) -->
              <TextBlock x:Name="ServerBlockHeader" Text="СЕРВЕРЫ СООБЩЕСТВА" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,22,0,10"/>
              <Border x:Name="ServerCardBorder" CornerRadius="16" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" Padding="20">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel VerticalAlignment="Center">
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                      <Border Background="#1C2420" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock Text="🌐 СЕРВЕРЫ KS NETWORK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                      </Border>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ServerStatusDot" Width="8" Height="8" CornerRadius="4" Background="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServerStatusText" Text="Пока что никто не играет (0 / 500 онлайн)" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </DockPanel>

                    <TextBlock Text="KS Network · Официальные сервера" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ServerDescText" Text="Серверы готовятся к открытию нового сезона. Скоро здесь появится мониторинг популярных режимов с автоподключением. А пока вы можете играть в одиночном режиме или со своими сборками модов!" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" MaxWidth="720"/>
                  </StackPanel>

                  <Border Grid.Column="1" Background="#0C1310" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" VerticalAlignment="Center" Margin="20,0,0,0">
                    <StackPanel>
                      <TextBlock x:Name="ServerIpText" Text="play.kslauncher.ru" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="14" FontFamily="Consolas" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                      <Button Content="📋 Скопировать IP" Padding="12,6" FontSize="12" FontWeight="Bold" Background="{DynamicResource Accent}" Foreground="#0E1311" BorderThickness="0" Cursor="Hand" Click="CopyServerIp_Click" ToolTip="Скопировать адрес сервера для игры"/>
                      <TextBlock x:Name="ServerSubtext" Text="⚡ Скоро открытие" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <!-- Список нововведений на главном экране -->
              <TextBlock Text="НОВОВВЕДЕНИЯ И ОБНОВЛЕНИЯ" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,26,0,12"/>
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel>
                  <DockPanel LastChildFill="False" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Background="{DynamicResource Accent}" Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0"/>
                      <TextBlock Text="KS Launcher v0.2.0 • Свежее обновление" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <Border Background="#1C2923" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="10,4" DockPanel.Dock="Right">
                      <TextBlock Text="Что нового" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    </Border>
                  </DockPanel>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0">
                      <Border Background="#121B18" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="▦ Библиотека и кастомные версии" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                          <TextBlock Text="Создавайте собственные версии и сборки в Библиотеке с выбором любого названия, загрузчика и добавлением модов с автоскачиванием зависимостей." Foreground="#C9D8D0" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                      </Border>

                      <Border Background="#121B18" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="🔧 Восстановление «Починить сборку»" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                          <TextBlock Text="Если игра вылетает или повреждены файлы, кнопка «Починить сборку» очистит битый кэш и переустановит библиотеки, сохраняя миры." Foreground="#C9D8D0" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                      </Border>

                      <Border Background="#121B18" CornerRadius="10" Padding="14">
                        <StackPanel>
                          <TextBlock Text="⚡ Поиск модов по Enter" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                          <TextBlock Text="Больше не нужно кликать мышью: наберите название мода и просто нажмите клавишу Enter для мгновенного поиска." Foreground="#C9D8D0" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                      <Border Background="#121B18" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="📦 Поддержка CurseForge и Modrinth" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                          <TextBlock Text="Выбирайте между двумя крупнейшими каталогами модов в один клик. Все обязательные зависимости скачиваются автоматически!" Foreground="#C9D8D0" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                      </Border>

                      <Border Background="#121B18" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="🌐 Выбор языка при скачивании" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                          <TextBlock Text="Выберите русский или английский язык прямо при скачивании лаунчера и установке игры." Foreground="#C9D8D0" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                      </Border>

                      <Border Background="#121B18" CornerRadius="10" Padding="14">
                        <StackPanel>
                          <TextBlock Text="🎨 Параллельный умный видео-фон" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                          <TextBlock Text="Фоновые обои и видео работают параллельно, а цвета палитры лаунчера автоматически адаптируются под ваш фон." Foreground="#C9D8D0" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 2. Библиотека (Управление версиями, создание сборок, добавление модов с зависимостями) -->
        <TabItem Header="Библиотека">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
              <TextBlock Text="Библиотека версий и сборок" FontSize="26" FontWeight="Bold"/>
              <TextBlock Text="Управление игровыми профилями, создание новых сборок с автоматической установкой модов и их зависимостей." Foreground="{StaticResource Muted}" Margin="0,6,0,18" FontSize="14"/>

              <!-- Форма создания новой версии с выбором модов -->
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                  <TextBlock Text="Создать новую версию или сборку" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                  <TextBlock Text="Задайте название сборки, выберите версию Minecraft, загрузчик и отметьте нужные моды — все обязательные зависимости скачаются автоматически!" Foreground="{StaticResource Muted}" Margin="0,4,0,14" FontSize="13"/>

                  <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="Название сборки" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                      <TextBox x:Name="NewInstanceNameBox" Text="Моя сборка" Width="220"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="Версия Minecraft" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                      <ComboBox x:Name="NewInstanceVersionBox" Width="160" DisplayMemberPath="Id"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="Загрузчик" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                      <ComboBox x:Name="NewInstanceLoaderBox" Width="140" SelectedIndex="1">
                        <ComboBoxItem Content="Vanilla" Tag="vanilla"/>
                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                        <ComboBoxItem Content="Forge" Tag="forge"/>
                        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                        <ComboBoxItem Content="Quilt" Tag="quilt"/>
                      </ComboBox>
                    </StackPanel>

                    <Button x:Name="CreateInstanceButton" Content="➕   Создать сборку" Background="{DynamicResource Accent}" Foreground="#101512" BorderBrush="{DynamicResource Accent}" Padding="18,10" VerticalAlignment="Bottom" Click="CreateInstance_Click"/>
                  </WrapPanel>

                  <!-- Блок добавления популярных модов в сборку с автозагрузкой зависимостей -->
                  <Border Background="#0C1411" BorderBrush="#1C2D24" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                      <DockPanel LastChildFill="False">
                        <TextBlock Text="🧩 Добавить моды в сборку (скачиваются вместе со всеми зависимостями):" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="13"/>
                        <TextBlock Text="Зависимости загружаются автоматически" Foreground="{StaticResource Muted}" FontSize="12" DockPanel.Dock="Right"/>
                      </DockPanel>

                      <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="ChkModFabricApi" Content="Fabric API" IsChecked="True" Margin="0,0,16,8" ToolTip="Базовая библиотека для работы модов Fabric"/>
                        <CheckBox x:Name="ChkModSodium" Content="Sodium / Оптимизация FPS" IsChecked="True" Margin="0,0,16,8" ToolTip="Мощный оптимизатор рендеринга"/>
                        <CheckBox x:Name="ChkModIris" Content="Iris Shaders" Margin="0,0,16,8" ToolTip="Поддержка современных шейдеров"/>
                        <CheckBox x:Name="ChkModFerriteCore" Content="FerriteCore (память)" IsChecked="True" Margin="0,0,16,8" ToolTip="Снижает потребление оперативной памяти"/>
                        <CheckBox x:Name="ChkModJei" Content="JEI (Рецепты крафтов)" Margin="0,0,16,8" ToolTip="Просмотр всех предметов и рецептов"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Список установленных и созданных сборок -->
              <DockPanel LastChildFill="False" Margin="2,0,0,10">
                <TextBlock Text="УСТАНОВЛЕННЫЕ СБОРКИ" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button Content="🔄  Обновить список" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Accent}" Padding="8,4" DockPanel.Dock="Right" Click="RefreshLibrary_Click"/>
              </DockPanel>

              <!-- Баннер запущенной сборки с кнопкой быстрой остановки -->
              <Border x:Name="LibraryRunningBanner" Background="#241416" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                  <Button Content="⏹   Остановить сборку" Background="#DC2626" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Padding="16,9" FontSize="13" Cursor="Hand" DockPanel.Dock="Right" Click="StopGame_Click" ToolTip="Принудительно закрыть зависшее окно или фоновый процесс"/>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <TextBlock x:Name="LibraryRunningTitleText" Text="Сборка сейчас запущена" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="Если игра зависла, окно не отвечает или остался фоновый процесс — нажмите кнопку остановки:" Foreground="#FCA5A5" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <ListBox x:Name="LibraryInstancesList" Background="Transparent" BorderThickness="0" Foreground="#F4F7F5" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#121917" BorderBrush="#26372D" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                          <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Border Background="#1E2B25" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Version}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#253528" CornerRadius="6" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Loader}" Foreground="#7CE38B" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                          </DockPanel>

                          <TextBlock Text="{Binding FolderPath}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,4"/>

                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="🧩 Модов в сборке: " Foreground="#A0B4AA" FontSize="13"/>
                            <TextBlock Text="{Binding ModsCount}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="13"/>
                          </StackPanel>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                          <Button Content="▶   Играть" Background="{DynamicResource Accent}" Foreground="#101512" BorderBrush="{DynamicResource Accent}" Padding="14,9" Margin="0,0,8,0" Click="LaunchLibraryInstance_Click"/>
                          <Button Content="⌘   Моды" Padding="12,9" Margin="0,0,8,0" ToolTip="Добавить моды прямо в эту сборку" Click="OpenInstanceMods_Click"/>
                          <Button Content="🔧   Починить сборку" Background="#1C2A22" BorderBrush="#3B5746" Foreground="{DynamicResource Accent}" Padding="14,9" Margin="0,0,8,0" Visibility="{Binding RepairVisibility}" ToolTip="Обнаружена ошибка с модами! Нажмите для анализа лога и восстановления" Click="RepairInstance_Click"/>
                          <Button Content="📁   Папка" Padding="12,9" Margin="0,0,8,0" ToolTip="Открыть папку инстанса в проводнике" Click="OpenInstanceFolder_Click"/>
                          <Button Content="🗑" Padding="10,9" Background="#281717" BorderBrush="#552222" Foreground="#FF8A8A" ToolTip="Удалить сборку" Click="DeleteInstance_Click"/>
                        </WrapPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 3. Моды и ресурсы -->
        <TabItem Header="Моды">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="Каталог модов и ресурсов" FontSize="26" FontWeight="Bold"/>
              <TextBlock Text="Ищите и устанавливайте проекты прямо в выбранную сборку из Библиотеки. Поддерживаются Modrinth и CurseForge с автоскачиванием зависимостей." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12" FontSize="14"/>
            </StackPanel>

            <!-- Выбор сборки из Библиотеки, куда устанавливать моды -->
            <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
              <DockPanel LastChildFill="False">
                <TextBlock Text="Устанавливать в сборку:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="ModTargetInstanceBox" Width="280" DisplayMemberPath="Name" SelectionChanged="ModTargetInstanceBox_SelectionChanged" ToolTip="Выберите сборку из Библиотеки, в которую будут ставиться моды"/>
                <TextBlock x:Name="ModTargetInfoText" Text="Общая папка (сборка не выбрана)" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Content="✕ Сбросить" Padding="10,6" FontSize="12" DockPanel.Dock="Right" Click="ClearModTargetInstance_Click" ToolTip="Устанавливать без привязки к конкретной сборке"/>
              </DockPanel>
            </Border>

            <!-- Панель поиска и фильтров с увеличенной кнопкой поиска и выбором каталога -->
            <DockPanel Grid.Row="2" Margin="0,0,0,14">
              <!-- Выбор каталога: Modrinth / CurseForge -->
              <ComboBox x:Name="ModSourceBox" Width="140" SelectedIndex="0" ToolTip="Источник модов" Margin="0,0,8,0" SelectionChanged="ModSourceBox_SelectionChanged">
                <ComboBoxItem Content="Modrinth" Tag="modrinth"/>
                <ComboBoxItem Content="CurseForge" Tag="curseforge"/>
              </ComboBox>

              <ComboBox x:Name="ProjectTypeBox" Width="145" Margin="0,0,8,0" SelectedIndex="0">
                <ComboBoxItem Content="Моды" Tag="mod"/>
                <ComboBoxItem Content="Модпаки" Tag="modpack"/>
                <ComboBoxItem Content="Ресурспаки" Tag="resourcepack"/>
                <ComboBoxItem Content="Шейдеры" Tag="shader"/>
              </ComboBox>

              <ComboBox x:Name="ModLoaderBox" Width="125" Margin="0,0,8,0" SelectedIndex="1" SelectionChanged="ModLoaderBox_SelectionChanged">
                <ComboBoxItem Content="Vanilla" Tag="vanilla"/>
                <ComboBoxItem Content="Fabric" Tag="fabric"/>
                <ComboBoxItem Content="Forge" Tag="forge"/>
                <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                <ComboBoxItem Content="Quilt" Tag="quilt"/>
                <ComboBoxItem Content="Any" Tag="Any"/>
              </ComboBox>

              <ComboBox x:Name="ModVersionBox" Width="130" Margin="0,0,8,0" DisplayMemberPath="Id"/>

              <!-- Крупная кнопка поиска модов справа -->
              <Button x:Name="SearchModsButton" DockPanel.Dock="Right" Content="🔍   Найти моды" Height="42" Padding="24,0" FontSize="14" FontWeight="Bold" Background="{DynamicResource Accent}" Foreground="#101512" BorderBrush="{DynamicResource Accent}" Margin="8,0,0,0" Click="SearchMods_Click"/>

              <!-- Поле поиска: с обработкой Enter и скругленной формой -->
              <TextBox x:Name="ModSearchBox" Style="{StaticResource RoundedSearchBoxStyle}" Text="" ToolTip="Поиск модов (оставьте пустым для показа популярных)" VerticalContentAlignment="Center" KeyDown="ModSearchBox_KeyDown"/>
            </DockPanel>

            <!-- Список результатов с улучшенным цветом текста и иконкой скачивания -->
            <ListBox x:Name="ModsList" Grid.Row="3" Background="Transparent" BorderThickness="0" Foreground="#F4F7F5" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#121917" BorderBrush="#26372D" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel VerticalAlignment="Center">
                        <DockPanel LastChildFill="False">
                          <!-- Изменён цвет заголовка на яркий белый -->
                          <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                          <!-- Бейдж платформы (Modrinth или CurseForge) -->
                          <Border Background="#1C2A22" BorderBrush="{Binding PlatformColor}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Platform}" Foreground="{Binding PlatformColor}" FontSize="11" FontWeight="Bold"/>
                          </Border>
                          <!-- Кнопка ядра / загрузчика мода (кликабельная) -->
                          <Button Content="{Binding Loader}" Style="{StaticResource TagButton}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Нажмите для фильтрации по этому ядру" Click="ModLoaderTag_Click"/>
                          <!-- Кнопка версии мода (кликабельная) -->
                          <Button Content="{Binding Version}" Style="{StaticResource TagButton}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Нажмите для фильтрации по этой версии" Click="ModVersionTag_Click"/>
                        </DockPanel>

                        <!-- Изменён цвет текста описания на мягкий читаемый мятно-белый -->
                        <TextBlock Text="{Binding Description}" Foreground="#CBE5D8" TextWrapping="Wrap" Margin="0,6,16,0" FontSize="13" LineHeight="18"/>

                        <!-- Индикатор скачиваний с иконкой и ярким цветом -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                          <TextBlock Text="⬇  " Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="Bold"/>
                          <TextBlock Text="{Binding Downloads, StringFormat={}{0:N0} скачиваний}" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                      </StackPanel>

                      <!-- Компактная кнопка с иконкой загрузки -->
                      <Button Grid.Column="1" Content="⬇" Width="44" Height="44" Padding="0" FontSize="20" FontWeight="Black"
                              Background="{DynamicResource Accent}" Foreground="#101512" BorderBrush="{DynamicResource Accent}"
                              ToolTip="Скачать и установить в лаунчер" VerticalAlignment="Center" Click="InstallMod_Click">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="DlChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DlChrome" Property="Opacity" Value="0.88"/></Trigger>
                              <Trigger Property="IsPressed" Value="True"><Setter TargetName="DlChrome" Property="Opacity" Value="0.75"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <!-- 4. Аккаунты -->
        <TabItem Header="Аккаунты">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
              <TextBlock Text="Аккаунты" FontSize="26" FontWeight="Bold"/>
              <TextBlock Text="Управление профилями игры и учётной записью KS System." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20" FontSize="14"/>

              <!-- Список сохранённых аккаунтов (AccountManager) -->
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                  <DockPanel LastChildFill="False">
                    <TextBlock Text="Сохранённые аккаунты" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="Быстрое переключение профиля в один клик" Foreground="{StaticResource Muted}" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ListBox x:Name="SavedAccountsList" Background="Transparent" BorderThickness="0" Margin="0,12,0,0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="SavedAccountItem_DoubleClick"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <ContentPresenter/>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <!-- Неактивный профиль по умолчанию СЕРЫЙ и полупрозрачный -->
                        <Border x:Name="AccountCard" Background="#111312" BorderBrush="#262D29" BorderThickness="1.5" CornerRadius="10" Padding="14,11" Cursor="Hand" Opacity="0.55"
                                PreviewMouseLeftButtonDown="SavedAccountCard_PreviewMouseDown" ToolTip="Дважды кликните (2×), чтобы сделать этот профиль активным">
                          <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <!-- Серый текст для неактивного аккаунта -->
                              <TextBlock x:Name="AccountTitle" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="#8B9590" VerticalAlignment="Center"/>
                              <Border x:Name="TypeBadge" Background="#171B19" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TypeText" Text="{Binding Type}" Foreground="#66746E" FontSize="11" FontWeight="SemiBold"/>
                              </Border>
                              <!-- Бейдж активного профиля (скрыт у неактивных) -->
                              <Border x:Name="ActiveBadge" Background="#24193B" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="✔ АКТИВЕН" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                              </Border>
                            </StackPanel>

                            <Button Content="Удалить" Padding="10,5" Background="#281717" BorderBrush="#552222" Foreground="#FF8A8A" DockPanel.Dock="Right" Click="RemoveSavedAccount_Click" ToolTip="Удалить аккаунт"/>
                            <TextBlock x:Name="InactiveHint" Text="2× клик для активации" Foreground="#55625C" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" DockPanel.Dock="Right"/>
                          </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <!-- Активный профиль: полностью яркий, белый текст, фиолетово-голубая рамка, бейдж ✔ АКТИВЕН -->
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="AccountCard" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="AccountCard" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="AccountCard" Property="Background" Value="#1E1633"/>
                            <Setter TargetName="AccountTitle" Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="AccountTitle" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="TypeBadge" Property="Background" Value="#2F1E56"/>
                            <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="InactiveHint" Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18">
                <StackPanel>
                  <TextBlock Text="Офлайн-профиль" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Локальный ник. Не даёт доступ к серверам online-mode." Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
                  <DockPanel>
                    <TextBox x:Name="OfflineNameBox" Text="Steve" Width="240"/>
                    <Button Content="Сохранить ник" Margin="9,0,0,0" Click="SaveOffline_Click"/>
                  </DockPanel>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Microsoft · Minecraft Java" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Официальный вход Microsoft → Xbox → Minecraft. Сессия игры хранится в памяти лаунчера." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                  <Button x:Name="MicrosoftLoginButton" Content="Войти через Microsoft" HorizontalAlignment="Left" Click="MicrosoftLogin_Click"/>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="KS System · аккаунт лаунчера" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Регистрация и косметика KS System. Этот аккаунт не заменяет лицензию Microsoft. URL сайта/API задаётся после публикации на Cloudflare." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                  <TextBox x:Name="CloudUrlBox" Text="https://kslauncher-api.nerck522.workers.dev" Margin="0,0,0,8"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Email" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                      <TextBox x:Name="CloudEmailBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                      <TextBlock Text="Ник KS System" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                      <TextBox x:Name="CloudUsernameBox"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Пароль" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                  <PasswordBox x:Name="CloudPasswordBox" Margin="0,0,0,10"/>
                  <WrapPanel>
                    <Button Content="Войти" Click="CloudLogin_Click"/>
                    <Button Content="Регистрация" Margin="8,0,0,0" Click="CloudRegister_Click"/>
                    <Button x:Name="CloudLogoutButton" Content="Выйти" Margin="8,0,0,0" IsEnabled="False" Click="CloudLogout_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="CloudStatusText" Text="Не подключено" Foreground="{StaticResource Muted}" Margin="0,10,0,8"/>
                  <WrapPanel>
                    <Button Content="Загрузить скин" Click="UploadSkin_Click"/>
                    <Button Content="Загрузить плащ" Margin="8,0,0,0" Click="UploadCape_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Ely.by" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Вход откроется на ely.by; секрет OAuth хранится только в Cloudflare Worker. Укажите URL вашего KS Worker ниже." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                  <TextBlock Text="Worker URL (Cloudflare)" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                  <DockPanel Margin="0,0,0,10">
                    <Button Content="💾  Сохранить" DockPanel.Dock="Right" Padding="14,8" Margin="8,0,0,0" Click="SaveElyWorkerUrl_Click"/>
                    <TextBox x:Name="ElyWorkerUrlBox" Text="https://kslauncher-api.nerck522.workers.dev/" VerticalContentAlignment="Center" Padding="10,8"/>
                  </DockPanel>
                  <Button x:Name="ElyLoginButton" Content="➕  Добавить аккаунт Ely.by" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Foreground="#101512" BorderBrush="{DynamicResource Accent}" Padding="18,10" Click="ElyLogin_Click"/>
                  <TextBlock x:Name="ElyStatusText" Text="Укажите Worker URL и нажмите «Войти через Ely.by»" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 5. Настройки -->
        <TabItem Header="Настройки">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
              <TextBlock Text="Настройки лаунчера" FontSize="26" FontWeight="Bold"/>
              <TextBlock Text="Параметры графики, среды выполнения Java и оформления." Foreground="{StaticResource Muted}" Margin="0,8,0,20" FontSize="14"/>

              <!-- Обновление лаунчера в 1 клик (без инсталлятора) -->
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <DockPanel LastChildFill="False">
                      <TextBlock Text="ОБНОВЛЕНИЕ ЛАУНЧЕРА" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <Border Background="#1A2D23" BorderBrush="#2F4C3B" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Версия v0.2.0" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold"/>
                      </Border>
                    </DockPanel>
                    <TextBlock x:Name="UpdateStatusText" Text="Обновляйте лаунчер в 1 клик прямо из настроек без необходимости повторно скачивать установщик." 
                               Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,8"/>
                    <ProgressBar x:Name="UpdateProgressBar" Height="4" Maximum="100" Visibility="Collapsed" Margin="0,4,0,4"/>
                  </StackPanel>

                  <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="⚡   Проверить и обновить лаунчер" 
                          Padding="20,12" FontSize="13.5" FontWeight="Bold" Background="{DynamicResource Accent}" Foreground="#0E1311" 
                          BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Margin="16,0,0,0" Click="CheckUpdate_Click" 
                          ToolTip="Проверить наличие обновлений на сервере и мгновенно обновить лаунчер"/>
                </Grid>
              </Border>

              <!-- Выбор Java Runtime (JavaService) -->
              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18">
                <StackPanel>
                  <TextBlock Text="Среда выполнения Java (JRE / JDK)" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Лаунчер автоматически определяет установленные версии Java в системе (Java 8, 17, 21)." Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
                  <DockPanel LastChildFill="True">
                    <Button Content="Обзор..." DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseJava_Click"/>
                    <ComboBox x:Name="JavaRuntimeBox" DisplayMemberPath="Name" SelectionChanged="JavaRuntimeBox_SelectionChanged"/>
                  </DockPanel>
                  <TextBlock x:Name="JavaStatusText" Text="Рекомендуется оставить автоматический выбор." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>

              <!-- Папка файлов игры Minecraft и сборок -->
              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Папка файлов Minecraft и сборок" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Все версии, моды, библиотеки и миры сохраняются в этой папке. Можно выбрать любой диск (D:, E:, F:), чтобы освободить системный диск C:." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                  <DockPanel LastChildFill="True">
                    <Button Content="📂  Открыть" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OpenGameDirectory_Click" ToolTip="Открыть папку в проводнике Windows"/>
                    <Button Content="Обзор..." DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseGameDirectory_Click" ToolTip="Выбрать другую папку или диск"/>
                    <TextBox x:Name="GameDirectoryBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="10,8"/>
                  </DockPanel>
                  <TextBlock x:Name="GameDirectoryStatusText" Text="Используется стандартное расположение: %APPDATA%\KSLauncher\instances" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Фон лаунчера" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Выберите изображение или MP4-видео. Видео и фоновое изображение работают параллельно, а цвета палитры лаунчера автоматически адаптируются под ваш фон." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                  <WrapPanel>
                    <Button Content="Выбрать изображение или MP4" Click="ChooseBackground_Click"/>
                    <Button Content="Убрать фон" Margin="8,0,0,0" Click="ClearBackground_Click"/>
                    <Button Content="✨ Подобрать цвета по фону" Margin="8,0,0,0" Click="ReextractColors_Click" ToolTip="Автоматически определить главные цвета из установленного фона"/>
                  </WrapPanel>
                  <TextBlock x:Name="BackgroundStatusText" Text="Используется стандартный фон" Foreground="{StaticResource Muted}" Margin="0,10,0,8"/>
                  
                  <DockPanel Margin="0,8,0,2">
                    <TextBlock Text="Затемнение фона · регулирует затемнение обоев" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="BackgroundDimValueLabel" Text="70%" Foreground="{DynamicResource Accent}" FontWeight="Bold" DockPanel.Dock="Right"/>
                  </DockPanel>
                  <Slider x:Name="BackgroundDimSlider" Minimum="0.05" Maximum="0.85" Value="0.70" ValueChanged="BackgroundDim_Changed"/>

                  <DockPanel Margin="0,12,0,2">
                    <TextBlock Text="Прозрачность окон и панелей · делает фон лаунчера видимым" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="PanelOpacityValueLabel" Text="85%" Foreground="{DynamicResource Accent}" FontWeight="Bold" DockPanel.Dock="Right"/>
                  </DockPanel>
                  <Slider x:Name="PanelOpacitySlider" Minimum="0.15" Maximum="1.00" Value="0.85" ValueChanged="PanelOpacity_Changed"/>
                </StackPanel>
              </Border>

              <!-- Атмосферные эффекты частиц (FX) -->
              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <DockPanel LastChildFill="False">
                    <TextBlock Text="Атмосферные эффекты частиц (FX)" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#1C2923" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="7,2" DockPanel.Dock="Right">
                      <TextBlock Text="60 FPS • GPU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                    </Border>
                  </DockPanel>
                  <TextBlock Text="Анимированные эффекты на фоне лаунчера. Частицы адаптируются под ваши выбранные цвета и градиенты, красиво просвечивая сквозь полупрозрачные окна." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14"/>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                      <TextBlock Text="ТИП ЭФФЕКТА" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                      <ComboBox x:Name="FxTypeBox" SelectedIndex="0" SelectionChanged="FxTypeBox_SelectionChanged">
                        <ComboBoxItem Content="Без эффектов" Tag="none"/>
                        <ComboBoxItem Content="Дождь" Tag="rain"/>
                        <ComboBoxItem Content="Снегопад" Tag="snow"/>
                        <ComboBoxItem Content="Парящие искры" Tag="sparks"/>
                        <ComboBoxItem Content="Матричный поток" Tag="matrix"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="КОЛИЧЕСТВО ЧАСТИЦ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="FxDensityLabel" Text="60 шт." Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="11" DockPanel.Dock="Right"/>
                      </DockPanel>
                      <Slider x:Name="FxDensitySlider" Minimum="20" Maximum="150" Value="60" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="FxDensitySlider_Changed"/>
                    </StackPanel>
                  </Grid>

                  <DockPanel Margin="0,14,0,4">
                    <TextBlock Text="Скорость движения частиц" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="FxSpeedLabel" Text="1.0x" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                  </DockPanel>
                  <Slider x:Name="FxSpeedSlider" Minimum="0.4" Maximum="2.5" Value="1.0" ValueChanged="FxSpeedSlider_Changed"/>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <StackPanel>
                      <TextBlock Text="Цвет 1" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                      <Image x:Name="PrimaryColorWheelImage" Tag="Primary" Width="180" Height="180" Stretch="Fill" Cursor="Hand" MouseLeftButtonDown="ColorWheel_MouseLeftButtonDown"/>
                    </StackPanel>
                    <StackPanel x:Name="SecondaryColorWheelPanel" Visibility="Collapsed" Margin="10,0,0,0">
                      <TextBlock Text="Цвет 2" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                      <Image x:Name="SecondaryColorWheelImage" Tag="Secondary" Width="136" Height="136" Stretch="Fill" Cursor="Hand" MouseLeftButtonDown="ColorWheel_MouseLeftButtonDown"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Настройка оттенка" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActiveAccentColorLabel" Text="Цвет 1 · яркость" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                    <Slider x:Name="AccentBrightnessSlider" Minimum="0.3" Maximum="1" Value="1" ValueChanged="AccentBrightness_Changed"/>
                    <TextBlock x:Name="AccentModeLabel" Text="Матовый цвет · один оттенок" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <CheckBox x:Name="GradientAccentBox" Content="Градиент · два цвета" Checked="GradientAccent_Changed" Unchecked="GradientAccent_Changed" Margin="0,4,0,0"/>
                    <TextBlock Text="Предпросмотр" Foreground="{StaticResource Muted}" Margin="0,10,0,5"/>
                    <Border x:Name="AccentPreview" Height="34" CornerRadius="8" Background="{DynamicResource Accent}"/>
                    <WrapPanel Margin="0,10,0,0">
                      <Button Content="Применить" Padding="20,9" Click="ApplyTheme_Click"/>
                      <TextBlock x:Name="AccentApplyStatus" Text="Изменения вступят в силу после применения" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Версии Minecraft" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Загружается полный список из Mojang. Снимки и beta можно включить отдельно." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                  <CheckBox x:Name="IncludeSnapshotsBox" Content="Показывать snapshots и старые версии" Checked="VersionFilter_Changed" Unchecked="VersionFilter_Changed"/>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Память и производительность" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Java автоматически использует доступные логические потоки. Увеличение числа ядер флагом не ускоряет генерацию мира и может ухудшить отзывчивость Windows." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                  <CheckBox x:Name="StringDedupBox" Content="Включить String Deduplication" Foreground="#F4F7F5" IsChecked="True"/>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Язык интерфейса и игры" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Выберите язык для лаунчера и процесса скачивания/установки игры." Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
                  <ComboBox x:Name="GameLanguageBox" Width="200" HorizontalAlignment="Left" SelectedIndex="0" ToolTip="Язык игры и интерфейса" SelectionChanged="GameLanguageBox_SelectionChanged">
                    <ComboBoxItem Content="🇷🇺 Русский" Tag="ru"/>
                    <ComboBoxItem Content="🇬🇧 English" Tag="en"/>
                  </ComboBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 6. KS Friends (Тестовая версия) -->
        <TabItem Header="KS Friends">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,10,12">
              <!-- Заголовок и мой Friend ID -->
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="16" Padding="20">
                <DockPanel LastChildFill="False">
                  <StackPanel>
                    <TextBlock Text="KS Friends" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Добавляйте друзей по ID (KS-12345678) или вставляйте код приглашения KSINV:... — работает с любыми аккаунтами и из любой страны." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <StackPanel Orientation="Horizontal">
                      <Border Background="#0E1412" BorderBrush="#293630" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Мой ID: " Foreground="{StaticResource Muted}" FontSize="13"/>
                          <TextBlock x:Name="MyFriendCodeText" Text="KS-00000000" FontWeight="Bold" Foreground="{DynamicResource Accent}" FontSize="13"/>
                        </StackPanel>
                      </Border>
                      <Border Background="#0E1412" BorderBrush="#293630" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <TextBlock x:Name="MyFriendSystemText" Text="Система: Offline" Foreground="#F4F7F5" FontSize="13"/>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="📋 Скопировать мой ID" Padding="12,9" Click="CopyMyFriendCode_Click"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- Входящие приглашения в игру / сборку -->
              <Border x:Name="InvitesBanner" Background="#16251E" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="ВХОДЯЩИЕ ПРИГЛАШЕНИЯ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                  <ItemsControl x:Name="InvitesList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#0E1412" BorderBrush="#293630" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,6">
                          <DockPanel LastChildFill="False">
                            <StackPanel VerticalAlignment="Center" MaxWidth="620">
                              <TextBlock Text="{Binding Description}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                              <Button Content="⬇ Принять и зайти" Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderBrush="{DynamicResource Accent}" Padding="12,8" Margin="0,0,8,0" Tag="{Binding}" Click="AcceptInvite_Click"/>
                              <Button Content="Отклонить" Padding="10,8" Tag="{Binding}" Click="DismissInvite_Click"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Добавить друга или принять код приглашения -->
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="AddFriendInputBox" Grid.Column="0" Margin="0,0,10,0" ToolTip="Введите ник, KS-12345678 или вставьте код приглашения KSINV:..."/>
                  <Button Grid.Column="1" Content="+ Добавить / Вставить код" Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderBrush="{DynamicResource Accent}" Padding="14,10" Click="AddFriend_Click"/>
                </Grid>
              </Border>

              <!-- Список друзей -->
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                  <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock Text="Список друзей" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FriendsCountText" Text="0 друзей" Foreground="{StaticResource Muted}" FontSize="13" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ListBox x:Name="FriendsList" Background="Transparent" BorderThickness="0" MaxHeight="440">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="14,12" Margin="0,0,0,6">
                          <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="Bold"/>
                                  <Border Background="#1B2A23" BorderBrush="#2E4438" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SystemBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                  </Border>
                                  <TextBlock Text="{Binding FriendId}" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                              <Button Content="▶ Зайти к другу" Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderBrush="{DynamicResource Accent}" Padding="12,8" Margin="0,0,8,0" Tag="{Binding}" Click="JoinFriend_Click"/>
                              <Button Content="✉ Позвать" Padding="10,8" Margin="0,0,8,0" Tag="{Binding}" Click="InviteFriend_Click"/>
                              <Button Content="✕" Padding="10,8" Tag="{Binding}" Click="RemoveFriend_Click" ToolTip="Удалить из друзей"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 7. Локальные Серверы (Хост) -->
        <TabItem Header="Серверы">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,10,12">
              <!-- Создание локального сервера -->
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="16" Padding="18">
                <StackPanel>
                  <DockPanel LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel>
                      <TextBlock Text="Локальный хостинг серверов" FontSize="20" FontWeight="Bold"/>
                      <TextBlock Text="Создайте сервер на ПК (2–4+ ГБ ОЗУ). Подключение работает для любых аккаунтов (Microsoft, Ely.by, KS, Offline) и из других стран (UPnP)." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                      <TextBlock x:Name="PublicIpText" Text="Внешний IP: определение..." Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                      <TextBlock x:Name="LocalLanIpText" Text="LAN IP: определение..." Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                  </DockPanel>

                  <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <StackPanel Width="220" Margin="0,0,10,8">
                      <TextBlock Text="Название сервера" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <TextBox x:Name="ServerNameBox" Text="Сервер с друзьями"/>
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,10,8">
                      <TextBlock Text="Версия MC" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <ComboBox x:Name="ServerVersionBox" DisplayMemberPath="Id"/>
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,10,8">
                      <TextBlock Text="Ядро" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <ComboBox x:Name="ServerCoreBox" SelectedIndex="0">
                        <ComboBoxItem Content="Vanilla" Tag="vanilla"/>
                        <ComboBoxItem Content="Paper" Tag="paper"/>
                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Width="165" Margin="0,0,10,8">
                      <TextBlock Text="Оперативка (ОЗУ)" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <ComboBox x:Name="ServerRamBox" SelectedIndex="0">
                        <ComboBoxItem Content="2 ГБ (2048 МБ)" Tag="2048"/>
                        <ComboBoxItem Content="4 ГБ (4096 МБ)" Tag="4096"/>
                        <ComboBoxItem Content="6 ГБ (6144 МБ)" Tag="6144"/>
                        <ComboBoxItem Content="8 ГБ (8192 МБ)" Tag="8192"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,10,8">
                      <TextBlock Text="Порт" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <TextBox x:Name="ServerPortBox" Text="25565"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,10,8">
                      <TextBlock Text="Описание (MOTD)" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <TextBox x:Name="ServerMotdBox" Text="Локальный сервер KS Launcher"/>
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,10,8">
                      <TextBlock Text="Слоты" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <TextBox x:Name="ServerMaxPlayersBox" Text="20"/>
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,10,8">
                      <TextBlock Text="Режим игры" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <ComboBox x:Name="ServerGamemodeBox" SelectedIndex="0">
                        <ComboBoxItem Content="Выживание" Tag="survival"/>
                        <ComboBoxItem Content="Креатив" Tag="creative"/>
                        <ComboBoxItem Content="Приключение" Tag="adventure"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,10,8">
                      <TextBlock Text="Сложность" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                      <ComboBox x:Name="ServerDifficultyBox" SelectedIndex="2">
                        <ComboBoxItem Content="Мирная" Tag="peaceful"/>
                        <ComboBoxItem Content="Лёгкая" Tag="easy"/>
                        <ComboBoxItem Content="Нормальная" Tag="normal"/>
                        <ComboBoxItem Content="Сложная" Tag="hard"/>
                      </ComboBox>
                    </StackPanel>
                  </WrapPanel>

                  <DockPanel LastChildFill="False">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <CheckBox x:Name="ServerPvpBox" Content="PvP" IsChecked="True" Margin="0,0,16,0"/>
                      <CheckBox x:Name="ServerWhitelistBox" Content="Белый список (Whitelist)" IsChecked="False" Margin="0,0,16,0"/>
                      <TextBlock Text="✓ Вход открыт для всех аккаунтов (Microsoft, Ely.by, KS, Offline)" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <Button Content="+ Создать сервер" Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderBrush="{DynamicResource Accent}" Padding="16,10" DockPanel.Dock="Right" Click="CreateLocalServer_Click"/>
                  </DockPanel>
                </StackPanel>
              </Border>

              <!-- Список серверов и консоль -->
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="280"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Мои локальные серверы -->
                <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                  <StackPanel>
                    <TextBlock Text="Мои серверы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListBox x:Name="LocalServersList" Background="Transparent" BorderThickness="0" MaxHeight="380" SelectionChanged="LocalServersList_SelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="11,9" Margin="0,0,0,6">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>

                <!-- Панель управления и живая консоль -->
                <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                  <StackPanel>
                    <TextBlock x:Name="SelectedServerTitle" Text="Выберите или создайте сервер" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedServerStatus" Text="Статус: остановлен" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Button x:Name="StartServerBtn" Content="▶ Запустить" Background="{DynamicResource Accent}" Foreground="#FFFFFF" BorderBrush="{DynamicResource Accent}" Padding="12,8" Margin="0,0,6,6" Click="StartLocalServer_Click"/>
                      <Button x:Name="StopServerBtn" Content="■ Стоп" Background="#7F1D1D" BorderBrush="#991B1B" Padding="12,8" Margin="0,0,6,6" IsEnabled="False" Click="StopLocalServer_Click"/>
                      <Button Content="🎮 Зайти" Padding="10,8" Margin="0,0,6,6" Click="JoinOwnServer_Click" ToolTip="Запустить Minecraft и подключиться к своему серверу"/>
                      <Button Content="✉ Позвать друзей" Padding="10,8" Margin="0,0,6,6" Click="InviteFriendsToServer_Click" ToolTip="Отправить приглашение в KS Friends и скопировать код приглашения"/>
                      <Button Content="📋 Скопировать IP" Padding="10,8" Margin="0,0,6,6" Click="CopyLocalServerIp_Click"/>
                      <Button Content="🗑 Удалить" Padding="10,8" Margin="0,0,6,6" Click="DeleteLocalServer_Click"/>
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <ComboBox x:Name="EditServerRamBox" Width="170" Margin="0,0,8,4">
                        <ComboBoxItem Content="2 ГБ (2048 МБ)" Tag="2048"/>
                        <ComboBoxItem Content="4 ГБ (4096 МБ)" Tag="4096"/>
                        <ComboBoxItem Content="6 ГБ (6144 МБ)" Tag="6144"/>
                        <ComboBoxItem Content="8 ГБ (8192 МБ)" Tag="8192"/>
                      </ComboBox>
                      <Button Content="💾 Применить ОЗУ" Padding="10,7" FontSize="12" Margin="0,0,8,4" Click="SaveSelectedServerSettings_Click"/>
                    </WrapPanel>

                    <TextBox x:Name="ServerConsoleBox" Height="220" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="#090D0B" Foreground="#D1FAE5" Padding="10" Margin="0,0,0,8"/>

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="ServerCommandBox" Grid.Column="0" Margin="0,0,8,0" KeyDown="ServerCommandBox_KeyDown" ToolTip="Введите команду сервера (например: op Ник, say Привет, stop)"/>
                      <Button Grid.Column="1" Content="Отправить" Padding="14,10" Click="SendServerCommand_Click"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>

      <!-- Футер -->
      <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
        <TextBlock Text="KS LAUNCHER · WINDOWS DESKTOP" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
        <TextBlock Text=".NET 8 · CmlLib.Core • Modrinth &amp; CurseForge" Foreground="{StaticResource Muted}" FontSize="13" DockPanel.Dock="Right" VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
